+"""Algebraic regression checks; arrays here are not presented as field evidence."""
+from dataclasses import asdict
+import numpy as np
+import pytest
+from acsa import audit_adaptive_selection
+
+
+def test_singleton_groups_recover_row_bootstrap_and_se():
+    args = dict(selection_losses=[[0, 1], [1, 0], [2, 1]],
+                holdout_losses=[[1, 0], [4, 1], [2, 3], [8, 4]],
+                selection_tiebreak_scores=[[3, 0], [0, 1], [2, 1]],
+                bootstrap_samples=200, random_seed=42)
+    row = asdict(audit_adaptive_selection(**args))
+    grouped = asdict(audit_adaptive_selection(**args, selection_groups=['a', 'b', 'c'],
+                                             holdout_groups=['d', 'e', 'f', 'g']))
+    for key in ('resampling_method', 'standard_error_method'):
+        row.pop(key); grouped.pop(key)
+    for key in ('pointwise_standard_error', 'pointwise_95_radius'):
+        assert row.pop(key) == pytest.approx(grouped.pop(key), rel=1e-14)
+    assert row == grouped
+
+
+def test_unequal_group_sizes_preserve_pooled_mean_and_cr1():
+    # Two clusters: [0] and [3,3,3], pooled mean 2.25, group mean 1.5.
+    r = audit_adaptive_selection([[0], [1]], [[0], [3], [3], [3]],
+        selection_groups=['s1', 's2'], holdout_groups=['h1', 'h2', 'h2', 'h2'],
+        bootstrap_samples=400, random_seed=7)
+    assert r.selected_holdout_loss == 2.25
+    # Cluster residual totals -2.25, +2.25 => CR1 SE = 1.125.
+    assert r.pointwise_standard_error == 1.125
+    assert r.selected_holdout_loss_bootstrap_interval_95 == (0., 3.)
+    assert r.holdout_unit_count == 2 and r.holdout_largest_unit_fraction == .75
+
+
+def test_exact_cluster_selector_includes_loss_score_pairing():
+    # Four equiprobable cluster draws AA, AB, BA, BB. AB/BA have unequal
+    # row counts: candidate 1 wins their exact pooled-loss tie by score.
+    r = audit_adaptive_selection([[0, 2], [1, 0], [1, 0]], [[0, 0], [1, 1]],
+        selection_tiebreak_scores=[[3, 0], [0, 2], [0, 2]],
+        selection_groups=['a', 'b', 'b'], holdout_groups=['c', 'd'],
+        bootstrap_samples=4000, random_seed=12)
+    assert r.selected_candidate == 'candidate_1'
+    assert r.selection_bootstrap_frequencies[1] == pytest.approx(.75, abs=.025)
+
+
+def test_duplicate_rows_within_sources_do_not_multiply_information():
+    selection = np.array([[0, 1], [1, 0]])
+    holdout = np.array([[0, 1], [6, 2]])
+    original = audit_adaptive_selection(selection, holdout, selection_groups=['a', 'b'],
+        holdout_groups=['c', 'd'], bootstrap_samples=200, random_seed=3)
+    repeated = audit_adaptive_selection(np.repeat(selection, 20, axis=0),
+        np.repeat(holdout, 20, axis=0), selection_groups=np.repeat(['a', 'b'], 20),
+        holdout_groups=np.repeat(['c', 'd'], 20), bootstrap_samples=200, random_seed=3)
+    assert repeated.pointwise_standard_error == original.pointwise_standard_error
+    assert repeated.selected_holdout_loss_bootstrap_interval_95 == original.selected_holdout_loss_bootstrap_interval_95
+    assert repeated.selection_bootstrap_frequencies == original.selection_bootstrap_frequencies
+
+
+@pytest.mark.parametrize('selection_ids,holdout_ids', [
+    (['a', 'b'], None), (None, ['c', 'd']), (['a', 'b'], ['a', 'c']),
+    (['a', 'a'], ['c', 'd']), (['a'], ['c', 'd']),
+    ([None, 'a'], ['c', 'd']), ([float('nan'), 'a'], ['c', 'd']),
+    ([1., 2.], ['c', 'd']), ([True, 2], ['c', 'd']),
+    ([['a'], ['b']], ['c', 'd']), (['', 'b'], ['c', 'd']),
+    ('ab', ['c', 'd']), (1, ['c', 'd']),
+])
+def test_invalid_or_leaking_groups_rejected(selection_ids, holdout_ids):
+    with pytest.raises(ValueError):
+        audit_adaptive_selection([[0], [1]], [[0], [1]], bootstrap_samples=100,
+            selection_groups=selection_ids, holdout_groups=holdout_ids)
+
+
+def test_mixed_id_types_are_lossless_and_share_cross_partition_namespace():
+    r = audit_adaptive_selection([[0], [1]], [[0], [1]], bootstrap_samples=100,
+        selection_groups=[1, '1'], holdout_groups=[2, '2'])
+    assert r.selection_unit_count == 2
+    with pytest.raises(ValueError, match='disjoint'):
+        audit_adaptive_selection([[0], [1]], [[0], [1]], bootstrap_samples=100,
+            selection_groups=[np.int64(1), '1'], holdout_groups=[1, '2'])
