+    Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts" / "Cambria.ttc",
+    Path("/System/Library/Fonts/Supplemental/Cambria.ttc"),
+    Path("/System/Library/Fonts/Supplemental/STIXTwoMath.otf"),
+    Path("/usr/share/fonts/truetype/stix/stix2math.otf"),
+    Path("/usr/share/fonts/opentype/stix/stix2math.otf"),
+    Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
+    Path("/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf"),
+)
+
+MATH_FONT = None
+for _path in _MATH_FONT_CANDIDATES:
+    if not _path.is_file():
+        continue
+    try:
+        pdfmetrics.registerFont(TTFont("CambriaMath", str(_path)))
+    except (TTFError, OSError):
+        continue
+    MATH_FONT = _path
+    break
+if MATH_FONT is None:
+    for _path in candidate_font_files("Arial"):
+        try:
+            pdfmetrics.registerFont(TTFont("CambriaMath", str(_path)))
+        except (TTFError, OSError):
+            continue
+        MATH_FONT = _path
