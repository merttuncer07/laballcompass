+
+_FONT_HINTS = {
+    "Arial": ("arial.ttf", "Arial.ttf", "Arial Regular.ttf", "DejaVuSans.ttf", "LiberationSans-Regular.ttf"),
+    "Arial-Bold": ("arialbd.ttf", "Arial Bold.ttf", "DejaVuSans-Bold.ttf", "LiberationSans-Bold.ttf"),
+    "Arial-Italic": ("ariali.ttf", "Arial Italic.ttf", "DejaVuSans-Oblique.ttf", "LiberationSans-Italic.ttf"),
+}
+
+
+def candidate_font_files(alias):
+    seen = set()
+    for root in _FONT_ROOTS:
+        for name in _FONT_HINTS[alias]:
+            for path in sorted(root.rglob(name)):
+                resolved = path.resolve()
+                if resolved not in seen:
+                    seen.add(resolved)
+                    yield resolved
+
+
+def register_style_font(alias):
+    for path in candidate_font_files(alias):
+        try:
+            pdfmetrics.registerFont(TTFont(alias, str(path)))
+        except (TTFError, OSError):
+            continue
+        return True
+    return False
+
+
+def register_font_fallbacks():
+    return [alias for alias in FONT_ALIASES if not register_style_font(alias)]
+
